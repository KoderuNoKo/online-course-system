# Local dev (API on host): use localhost. Docker Compose overrides DATABASE_URL for the api service to host "mysql".
DATABASE_URL="mysql://root:root@localhost:3306/course_registration"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Optional: only needed for server-side fetches. Browser uses /api/* → Next rewrites to API_INTERNAL_URL (default 127.0.0.1:4000 in next.config).
API_INTERNAL_URL="http://127.0.0.1:4000"
NODE_ENV=development
