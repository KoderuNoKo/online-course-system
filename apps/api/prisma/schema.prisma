generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  AAO
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique @db.VarChar(191)
  passwordHash String             @map("password_hash") @db.VarChar(64)
  salt         String             @db.VarChar(64)
  role         Role
  fullName     String             @map("full_name") @db.VarChar(191)
  status       UserStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  sessions     Session[]
  forms        RegistrationForm[] @relation("StudentForms")
  decisions    RegistrationForm[] @relation("DecidedBy")
  enrollments  Enrollment[]

  @@map("users")
}

model Session {
  id             Int      @id @default(autoincrement())
  token          String   @unique @db.VarChar(128)
  userId         Int      @map("user_id")
  lastActivityAt DateTime @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Semester {
  id                Int                @id @default(autoincrement())
  code              String             @unique @db.VarChar(20)
  name              String             @db.VarChar(100)
  startDate         DateTime           @map("start_date")
  endDate           DateTime           @map("end_date")
  isCurrent         Boolean            @default(false) @map("is_current")
  courses           Course[]
  registrationForms RegistrationForm[]
  enrollments       Enrollment[]

  @@map("semesters")
}

model Course {
  id              Int                    @id @default(autoincrement())
  courseCode      String                 @map("course_code") @db.VarChar(20)
  courseName      String                 @map("course_name") @db.VarChar(191)
  department      String                 @db.VarChar(100)
  lecturer        String                 @db.VarChar(100)
  classroom       String                 @db.VarChar(50)
  schedule        String                 @db.VarChar(100)
  maxCapacity     Int                    @map("max_capacity")
  enrolledCount   Int                    @default(0) @map("enrolled_count")
  semesterId      Int                    @map("semester_id")
  isActive        Boolean                @default(true) @map("is_active")
  deletedAt       DateTime?              @map("deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  semester        Semester               @relation(fields: [semesterId], references: [id])
  formItems       RegistrationFormItem[]
  enrollments     Enrollment[]

  @@unique([courseCode, semesterId])
  @@index([semesterId, isActive, deletedAt])
  @@map("courses")
}

model RegistrationForm {
  id         Int                 @id @default(autoincrement())
  studentId  Int                 @map("student_id")
  semesterId Int                 @map("semester_id")
  status     RegistrationStatus  @default(DRAFT)
  submittedAt DateTime?          @map("submitted_at")
  decidedAt  DateTime?           @map("decided_at")
  decidedBy  Int?                @map("decided_by")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  student    User                @relation("StudentForms", fields: [studentId], references: [id])
  semester   Semester            @relation(fields: [semesterId], references: [id])
  officer    User?               @relation("DecidedBy", fields: [decidedBy], references: [id])
  items      RegistrationFormItem[]
  enrollments Enrollment[]

  @@unique([studentId, semesterId])
  @@index([status, submittedAt])
  @@map("registration_forms")
}

model RegistrationFormItem {
  id                 Int              @id @default(autoincrement())
  registrationFormId Int              @map("registration_form_id")
  courseId           Int              @map("course_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  form               RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  course             Course           @relation(fields: [courseId], references: [id])

  @@unique([registrationFormId, courseId])
  @@map("registration_form_items")
}

model Enrollment {
  id                 Int              @id @default(autoincrement())
  studentId          Int              @map("student_id")
  courseId           Int              @map("course_id")
  semesterId         Int              @map("semester_id")
  registrationFormId Int              @map("registration_form_id")
  enrolledAt         DateTime         @default(now()) @map("enrolled_at")
  student            User             @relation(fields: [studentId], references: [id])
  course             Course           @relation(fields: [courseId], references: [id])
  semester           Semester         @relation(fields: [semesterId], references: [id])
  registrationForm   RegistrationForm @relation(fields: [registrationFormId], references: [id])

  @@unique([studentId, courseId, semesterId])
  @@index([courseId, semesterId])
  @@map("enrollments")
}
